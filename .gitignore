# ============================================================================
# GYhost .gitignore
# ============================================================================
# 原则：仓库里只放「项目源码 + 构建脚本 + 文档」。
#   保留：*.go、*.cu、*.h、Makefile、go.mod/go.sum、build.sh、README.md、本文件
#   忽略：编译产物、运行/测试数据、第三方参考代码
#
# 分组如下；新增条目请归入对应分组并说明原因，避免以后看不懂为什么被忽略。
# 若某个被忽略的文件确实需要入库，用 `git add -f <file>` 强制添加。

# ---------------------------------------------------------------------------
# 编译产物
# ---------------------------------------------------------------------------

# 根目录可执行文件（make / go build 的输出）
/gyhost
/gyhost.exe

# build.sh 生成的多平台发布产物
/dist/

# CUDA 静态库与编译中间目标文件
# 由 internal/cuda/Makefile 生成（cuda.o -> libgyhost_cuda.a），
# cuda_kernel/ 与 freeclient 下的同名产物同理
*.o
*.a

# Go 测试与覆盖率产物
*.test
*.out
coverage.*
*.prof

# ---------------------------------------------------------------------------
# 运行 / 测试数据
# ---------------------------------------------------------------------------

# 根目录下的临时数据：待破解哈希、密码字典、样本压缩包、抓包
/*.txt
/*.zip
/*.7z
/*.rar
/*.cap
/*.pcap
/*.pcapng

# wifite / airodump-ng 的输出目录（抓包 + 字典，体积很大）
/wifite/

# 日志
*.log

# ---------------------------------------------------------------------------
# 第三方参考代码（不是本项目源码，不进仓库）
# ---------------------------------------------------------------------------

# hcxtools 是从上游 clone 的参考实现，自带 .git；
# 不排除的话 git 会把它当作内嵌仓库（gitlink）加入，导致仓库状态异常
/hcxtools/

# freeclient 是另一个独立 Go 模块（自带 go.mod），与 GYhost 无关
/freeclient/

# 依赖副本（若将来执行 go mod vendor，依赖代码同样不属于项目源码）
/vendor/

# ---------------------------------------------------------------------------
# 编辑器 / 操作系统
# ---------------------------------------------------------------------------

.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
